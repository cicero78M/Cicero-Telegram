PORT=3000
DB_USER=cicero
DB_HOST=localhost
DB_NAME=cicero_db
DB_PASS=secret
DB_PORT=5432
DB_DRIVER=postgres
NEXT_PUBLIC_API_URL=http://localhost:3000/api
RAPIDAPI_KEY=xxxx
RAPIDAPI_FALLBACK_KEY=
RAPIDAPI_FALLBACK_HOST=tiktok-api6.p.rapidapi.com
REDIS_URL=redis://localhost:6379
ALLOW_DUPLICATE_REQUESTS=false
SECRET_KEY=your-secret
JWT_SECRET=your-jwt-secret
AMQP_URL=amqp://localhost
GOOGLE_CONTACT_SCOPE=https://www.googleapis.com/auth/contacts
GOOGLE_SERVICE_ACCOUNT=/path/to/service-account.json
GOOGLE_IMPERSONATE_EMAIL=admin@example.com
BACKUP_DIR=./backups
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
DASHBOARD_PASSWORD_RESET_URL=https://papiqo.com/reset-password

# Telegram Bot Configuration
# Direktorat Bot - for dirRequest menu (directorate-level reporting and analytics)
TELEGRAM_DIREKTORAT_BOT_TOKEN=your-direktorat-bot-token-here
TELEGRAM_DIREKTORAT_BOT_ENABLED=false

# Operator Bot - for oprRequest menu (user management, amplification, engagement)
TELEGRAM_OPERATOR_BOT_TOKEN=your-operator-bot-token-here
TELEGRAM_OPERATOR_BOT_ENABLED=false

# User Bot - for userRequest menu (personal data management)
TELEGRAM_USER_BOT_TOKEN=your-user-bot-token-here
TELEGRAM_USER_BOT_ENABLED=false

# Legacy bot configuration (deprecated - use specific bot tokens above)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_ENABLED=false
